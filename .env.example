# Portexa environment variables
# Add these names in Vercel > Project > Settings > Environment Variables.
# Never put real keys in this file or in GitHub.

# Supabase (Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Paystack (use the sk_test_ key until you are ready to go live)
PAYSTACK_SECRET_KEY=sk_test_your-key-here

# Resend (email notifications)
RESEND_API_KEY=re_your-key-here
RESEND_FROM_EMAIL=Portexa <onboarding@resend.dev>
PORTEXA_RECEIVING_EMAIL=you@example.com

# One-time admin setup (choose a long random string)
ADMIN_SETUP_TOKEN=a-long-random-string
